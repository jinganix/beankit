{
  "name": "@beankit/promise-timeout",
  "version": "0.2.1",
  "description": "Race a promise against a timeout with fallback, custom errors, AbortSignal, and cleanup.",
  "keywords": [
    "promise",
    "timeout",
    "deadline",
    "abort",
    "abortsignal",
    "fallback",
    "cancel",
    "async",
    "beankit",
    "typescript"
  ],
  "homepage": "https://github.com/jinganix/beankit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinganix/beankit.git",
    "directory": "packages/promise-timeout"
  },
  "bugs": {
    "url": "https://github.com/jinganix/beankit/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "npm run typecheck:tsc && npm run lint",
    "typecheck:tsc": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src \"*.ts\" .prettierrc.* eslint.config.js --no-error-on-unmatched-pattern --max-warnings 0",
    "lint:fix": "eslint src \"*.ts\" .prettierrc.* eslint.config.js --no-error-on-unmatched-pattern --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
