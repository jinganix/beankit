{
  "name": "beankit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "beankit: tiny, sharp open-source packages (url-join, typing-event, replay, ...).",
  "keywords": [
    "beankit",
    "url-join",
    "typescript",
    "tiny"
  ],
  "homepage": "https://github.com/jinganix/beankit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinganix/beankit.git"
  },
  "bugs": {
    "url": "https://github.com/jinganix/beankit/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:packages": "node scripts/check-packages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
